#!/bin/bash

# Exit  immediately if a pipeline (which may consist of a single simple
# command), a list, or a compound command (see SHELL GRAMMAR above), exits with
# a non-zero status.
set -e  

# --- Constants ---
CONFIG_DIR=".pen"
CONFIG_FILE="$CONFIG_DIR/config.yaml"
ENV_FILE="$CONFIG_DIR/env"

readonly SCRIPT_DIR=$(dirname "$(realpath "${BASH_SOURCE[0]}")")
TEMPLATE_CONFIG="$SCRIPT_DIR/../config/default.yaml"

# If container alias/name is not provided by user through CLI, check if name is
# configured through configuration file, if nothing else works use fallback and
# return one based on the project dir(s) 
resolve_container_name() {
    local provided_name=$1
    local configured_name=$(config_value '.container.name')

    # man bash | CONDITIONAL EXPRESSIONS
    # "-n" True if the length of string is non-zero.
    if [[ -n "$provided_name" ]]; then
        echo "$provided_name"
    elif [[ -n "$configured_name" ]]; then
        echo "$configured_name"
    else
        # Logic: combine parent and current dir, lowercase, replace
        # non-alphanumeric with dash
        local full_path=$(pwd)
        local parent_dir=$(basename "$(dirname "$full_path")")
        local current_dir=$(basename "$full_path")
        
        echo "${parent_dir}-${current_dir}" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9]/-/g' | sed 's/--/-/g'
    fi
}

# --- Core Functions ---

config_value() {
    # Returns value of the given query, or nothing if the config file is missing
    # "-r" unwrap scalar, print the value with no quotes, colours or comments.
    # Defaults to true for yaml (default true)
    # NOTE: Even it's included (-r) by default make it explicit (don't like
    #       implicit logic) 
    [[ -f "$CONFIG_FILE" ]] && yq -r "$1" "$CONFIG_FILE"
}

init_config() {
    local template_path=${1:-$TEMPLATE_CONFIG}
    local provided_container_name=$2

    if [[ ! -d "$CONFIG_DIR" ]]; then
        mkdir -p "$CONFIG_DIR"
    fi
    if [[ ! -f "$CONFIG_FILE" ]]; then
        # Create configuration file from conf template and replace env vars
        # with their corresponding values 
        echo "Initializing config from $template_path..."
        cat "$template_path" | envsubst > "$CONFIG_FILE"
        # Set container name
        local container_name=$(resolve_container_name "$provided_container_name")
        # NOTE: local var is not visible for yq, so passing env var just for yq 
        container_name="$container_name" yq -i '.container.name = strenv(container_name)' $CONFIG_FILE
        # Create dedicated file for env vars (this will be sourced through
        # .bash_profile)
        echo "Generating environment file..."
        echo "$(config_value '.container.env')" | sed 's/: /=/' > $ENV_FILE
    fi
}

# TODO: this one should also take template type as arg (if omitted use default one)
pen_init() {
    local container_name=""
    local template_name=""

    while [[ $# -gt 0 ]]; do
        case "$1" in
            -n)
                container_name="$2"
                shift 2
                ;;
            -t)
                template_name="$2"
                shift 2
                ;;
            *)
                shift
                ;;
        esac
    done

    local template_path="$TEMPLATE_CONFIG"
    if [[ -n "$template_name" ]]; then
        template_path="$SCRIPT_DIR/../config/${template_name}.yaml"
        if [[ ! -f "$template_path" ]]; then
            echo "Error: Template $template_name not found at $template_path"
            return 1
        fi
    fi

    init_config "$template_path" "$container_name"

    local resolved_name=$(config_value '.container.name')
    echo "Using alias: $resolved_name"

    # Check if container exists (grep/match exact name)
    # Skip configuration logic if container already exists
    if incus list --columns n | grep -q -w "$resolved_name"; then
        echo "Container $resolved_name already exists. Skipping creation."
    else
        # Container Provisioning
        local container_image=$(config_value '.container.image')
        
        echo "Launching container $resolved_name from $container_image..."
        # TODO: This sleep should be removed (not really a hard requirement to
        # show ip addresses, but it would be nice to have those just using
        # either event or something)
        incus launch "$container_image" "$resolved_name" && sleep 2

        # Setup user at runtime (Host UID/GID)
        echo "Initial configuration..."
        local host_uid=$(id -u)
        local host_gid=$(id -g)
        local pen_user=$(config_value '.container.user')
        echo "Configuring user ${pen_user} (UID: ${host_uid}, GID: ${host_gid}) inside container..."
        incus exec "$resolved_name" -- /usr/local/bin/setup-user.sh "$pen_user" "$host_uid" "$host_gid"

        echo "Configuring firewall (opensnitch)"
        incus exec "$resolved_name" -- /usr/local/bin/configure-opensnitch.sh

        # Insert env vars to container
        echo "Integrating environment variables..."
        cat $ENV_FILE | incus exec "$resolved_name" -- tee --append /etc/environment > /dev/null

        # Dir/file mounts
        echo "Mounting volumes from host..."
        local mounts_count=$(config_value '.mounts | length')
        for ((i=0; i<mounts_count; i++)); do
            local src=$(i="$i" config_value '.mounts[env(i)].source')
            local dst=$(i="$i" config_value '.mounts[env(i)].target')
            local writeable=$(i="$i" config_value '.mounts[env(i)].writeable')
            local disk_id="mount$(echo $dst | tr '/' '_')"
            
            echo "Mounting $src to $dst (writeable=$writeable)..."
            incus config device add "$resolved_name" "$disk_id" disk path="$dst" source="$src" shift="$writeable"
        done

        echo "Container created:"
        incus ls "$resolved_name"
    fi
}

pen_destroy() {
    local container_name=$(config_value '.container.name')
    if [[ -z "$container_name" ]]; then
        echo "No configuration found or container name not specified."
        return 1
    fi

    read -p "Are you sure you want to stop and destroy container $container_name? (y/N): " confirm
    if [[ "$confirm" == [yY] || "$confirm" == [yY][eE][sS] ]]; then
        echo "Stopping and destroying $container_name..."
        incus stop "$container_name" || true
        incus delete "$container_name"
        rm -rf "$CONFIG_DIR"
        echo "Container destroyed."
    else
        echo "Operation cancelled."
    fi
}


pen_bash() {
    if [[ -f "$CONFIG_FILE" ]]; then
      local container_name=$(config_value '.container.name')
      local workdir=$(config_value '.container.cwd')

      # Get current container state ("-c s" - only return state column)
      # pipeline to xargs will strip empty spaces
      local container_state=$(incus ls "$container_name" -c s --format "compact,noheader" |xargs)

      if [[ "$container_state" == "STOPPED" ]]; then
          # TODO: This sleep should be removed (not really a hard requirement to
          # show ip addresses, but it would be nice to have those just using
          # either event or something)
          incus start "$container_name" && sleep 2 && container_state="RUNNING"
          incus ls "$container_name"
      fi

      if [[ "$container_state" == "RUNNING" ]]; then
          incus exec --cwd $(config_value '.container.cwd') "$container_name" -- su $(config_value '.container.user')
      else
          echo "Initialize pen first"
      fi
    else
      echo "Initialize pen first"
    fi
}

# --- CLI Entrypoint ---

case "$1" in
    init)
        pen_init "${@:2}"
        ;;
    destroy)
        pen_destroy
        ;;
    bash)
        pen_bash
        ;;
    *)
        echo "Usage: pen {init [-n alias] [-t template]|destroy|bash}"
        exit 1
        ;;
esac
