#!/bin/bash

# Exit  immediately if a pipeline (which may consist of a single simple
# command), a list, or a compound command (see SHELL GRAMMAR above), exits with
# a non-zero status.
set -e  

# --- Constants ---
CONFIG_DIR=".pen"
CONFIG_FILE="$CONFIG_DIR/config.yaml"
ENV_FILE="$CONFIG_DIR/env"
TEMPLATE_CONFIG="/etc/pen/config/default.yaml"

# If container alias/name is not provided by user through CLI, check if name is
# configured through configuration file, if nothing else works use fallback and
# return one based on the project dir(s) 
resolve_container_name() {
    local provided_name=$1
    local configured_name=$(config_value '.container.name')

    # man bash | CONDITIONAL EXPRESSIONS
    # "-n" True if the length of string is non-zero.
    if [[ -n "$provided_name" ]]; then
        echo "$provided_name"
    elif [[ -n "$configured_name" ]]; then
        echo "$configured_name"
    else
        # Logic: combine parent and current dir, lowercase, replace
        # non-alphanumeric with dash
        local full_path=$(pwd)
        local parent_dir=$(basename "$(dirname "$full_path")")
        local current_dir=$(basename "$full_path")
        
        echo "${parent_dir}-${current_dir}" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9]/-/g' | sed 's/--/-/g'
    fi
}

# --- Core Functions ---

config_value() {
    # Returns value of the given query, or nothing if the config file is missing
    # "-r" unwrap scalar, print the value with no quotes, colours or comments.
    # Defaults to true for yaml (default true)
    # NOTE: Even it's included (-r) by default make it explicit (don't like
    #       implicit logic) 
    [[ -f "$CONFIG_FILE" ]] && yq -r "$1" "$CONFIG_FILE"
}

init_config() {
    if [[ ! -d "$CONFIG_DIR" ]]; then
        mkdir -p "$CONFIG_DIR"
    fi
    if [[ ! -f "$CONFIG_FILE" ]]; then
        # Create configuration file from conf template and replace env vars
        # with their corresponding values 
        echo "Initializing default config..."
        cat "$TEMPLATE_CONFIG" | envsubst > "$CONFIG_FILE"
        # Set container name
        local provided_container_name=$1
        local container_name=$(resolve_container_name "$provided_container_name")
        # NOTE: local var is not visible for yq, so passing env var just for yq 
        container_name="$container_name" yq -i '.container.name = strenv(container_name)' $CONFIG_FILE
        # Create dedicated file for env vars (this will be sourced through
        # .bash_profile)
        echo "Generating environment file..."
        echo "$(config_value '.container.env')" | sed 's/: /=/' > $ENV_FILE
    fi
}

# TODO: this one should also take template type as arg (if omitted use default one)
pen_init() {
    init_config $1

    local container_name=$(config_value '.container.name')
    echo "Using alias: $container_name"

    # Check if container exists (grep/match exact name)
    # Skip configuration logic if container already exists
    if incus list --columns n | grep -q -w "$container_name"; then
        echo "Container $container_name already exists. Skipping creation."
    else
        # Container Provisioning
        local container_image=$(config_value '.container.image')
        
        echo "Launching container $container_name from $container_image..."
        incus init "$container_image" "$container_name"

        # Dir/file mounts
        local mounts_count=$(config_value '.mounts | length')
        for ((i=0; i<mounts_count; i++)); do
            local src=$(i="$i" config_value '.mounts[env(i)].source')
            local dst=$(i="$i" config_value '.mounts[env(i)].target')
            local writeable=$(i="$i" config_value '.mounts[env(i)].writeable')
            local disk_id="mount$(echo $dst | tr '/' '_')"
            
            echo "Mounting $src to $dst (writeable=$writeable)..."
            incus config device add "$container_name" "$disk_id" disk path="$dst" source="$src" shift="$writeable"
        done

        # Env Mount & Shell Integration
        echo "Integrating environment variables..."
        # Start container and give it a moment so that it handle network and
        # pick up ip addresses
        # TODO: This sleep should be removed (not really a hard requirement to
        # show ip addresses, but it would be nice to have those just using
        # either event or something)
        incus start "$container_name" && sleep 2

        # Insert env vars to container
        cat $ENV_FILE | incus exec "$container_name" -- tee --append /etc/environment > /dev/null

        echo "Container created:"
        incus ls "$container_name"
    fi
}

